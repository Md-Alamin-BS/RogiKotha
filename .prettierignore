# Prettier scope for `pnpm format:check` (T-010, functional-spec.md § 8, BR7.1-BR7.3): code and
# configuration under apps/, packages/, scripts/, lint-fixtures/, .github/workflows/ and the root.
# Prettier also reads .gitignore, so ignored output there never reaches this list.

# Installed dependencies.
node_modules
# Build output of Next.js and tsc.
**/dist
**/.next
# Coverage reports written by `pnpm test:coverage`.
coverage/
# Local database and upload data.
.data/
# Generated by pnpm; it rewrites the file on every install.
pnpm-lock.yaml
# Drizzle migrations and their snapshots are generated; reformatting would churn them.
**/migrations/**
# Ported verbatim from the prototype (staff console, 01-conventions.md §7.1) or the FD-091 patient
# stylesheet, whose layout T-011 decides.
apps/web/src/styles/**
# Markdown is prose; its wrapping is the author's.
**/*.md
# Design source of truth, kept byte for byte.
ui-design-prototype/**
# Prototype tooling, outside the application workspace.
tools/**
# Documentation tree.
docs/**
# AI-DLC records and memory, written by the framework.
aidlc/
# Harness engine folders shipped by AI-DLC and BMAD, updated by their installers.
.claude/
.codex/
.agents/
.github/agents/
.impeccable/
_bmad/
.mcp.json
# Generated files (header "Generated by … Do not hand-edit"): their generators write them, so a
# reformat would be undone on the next run. The same files are out of coverage (BR6.4).
packages/i18n/src/keys.ts
packages/test-support/src/corpus/*.ts
!packages/test-support/src/corpus/*.test.ts
!packages/test-support/src/corpus/index.ts
!packages/test-support/src/corpus/types.ts
# Written by `next build` and `next dev`.
apps/web/next-env.d.ts
