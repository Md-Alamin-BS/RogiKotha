# Copy this file to the repo root as `.env` and fill in the three generated secrets below.
# Do not commit `.env` (git-ignored by T-001) and do not put generated secret VALUES in this file.

APP_MODE=development            # development | demo | production — AD-14 assertion at start-up
APP_URL=http://localhost:3000
# Host port 5433, not Postgres's default 5432 (ISS-084): a native Windows PostgreSQL service
# already listening on 5432 on some developer machines silently shadowed the container's port.
DATABASE_URL=postgres://rk_app:rk_app@localhost:5433/rogikotha
DATABASE_URL_WORKER=postgres://rk_worker:rk_worker@localhost:5433/rogikotha
DATABASE_URL_TEST=postgres://rk_app:rk_app@localhost:5433/rogikotha_test
DATABASE_URL_MAINTENANCE=postgres://rk_maintenance:rk_maintenance@localhost:5433/rogikotha
APP_ENCRYPTION_KEY=              # 32 bytes base64 — generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=              # 32+ random chars — same command
# The worker's only key (FD-095): it seals and opens email recipients and nothing else. Use a value
# different from APP_ENCRYPTION_KEY. The worker deletes APP_ENCRYPTION_KEY and BETTER_AUTH_SECRET
# from its own environment when it loads this file.
MAIL_RECIPIENT_KEY=              # 32 bytes base64 — same command as APP_ENCRYPTION_KEY
TERMS_VERSION=1                  # the Terms version a new account accepts (T-101 register)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=RogiKotha <no-reply@demo.rogikotha.local>
MAILPIT_URL=http://localhost:8025   # shown on the verify-email screen when APP_MODE != production
CLAMD_HOST=localhost
CLAMD_PORT=3310
STORAGE_ROOT=./.data/storage
LOG_LEVEL=info

# ClamAV note: the container's first start downloads roughly 300 MB of official virus
# signatures via freshclamd before `clamd` accepts connections (can take several minutes).
# The custom test signature in infra/compose/clamav/rogikotha-test.ndb loads alongside the
# official database on every start, official download or not — it does not depend on it.
