{
  "name": "rogikotha",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @rogikotha/web dev",
    "dev:worker": "pnpm --filter @rogikotha/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:boundaries": "node scripts/check-boundaries-fixture.mjs",
    "format:check": "prettier --check .",
    "check:identity": "node scripts/check-identity.mjs",
    "test": "vitest run --config vitest.workspace.ts",
    "test:int": "vitest run --config vitest.workspace.ts --project database",
    "test:coverage": "vitest run --config vitest.workspace.ts --coverage",
    "smoke": "vitest run --config vitest.workspace.ts smoke.test",
    "i18n:check": "pnpm --filter @rogikotha/i18n check",
    "contrast": "node tools/contrast.mjs --tokens apps/web/src/styles/tokens.css",
    "contrast:patient": "node tools/contrast.mjs --tokens apps/web/src/styles/patient.css --pairs patient",
    "check:motion": "node scripts/css-motion-check.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:boundaries && pnpm format:check && pnpm check:identity && pnpm test:coverage && pnpm i18n:check && pnpm contrast && pnpm build",
    "db:generate": "pnpm --filter @rogikotha/database generate",
    "db:migrate": "pnpm --filter @rogikotha/database migrate",
    "db:reset": "pnpm --filter @rogikotha/database reset",
    "db:seed": "pnpm --filter @rogikotha/test-support seed",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/compose/docker-compose.yml logs -f",
    "infra:reset": "docker compose -f infra/compose/docker-compose.yml down -v",
    "demo": "pnpm infra:up && pnpm db:migrate && pnpm db:seed && pnpm -r --parallel dev",
    "demo:reset": "pnpm db:reset && pnpm db:seed",
    "fixtures:build": "pnpm --filter @rogikotha/test-support fixtures:build",
    "tools:check": "node tools/sync-tokens.mjs --check && node tools/coverage.mjs && node tools/i18n-audit.mjs && node tools/proof-check.mjs && node tools/contrast.mjs && node tools/bangla-metrics.mjs && node tools/check-detector.mjs && node tools/hover-probe.mjs && node tools/smoke.mjs",
    "tools:coverage": "node tools/coverage.mjs",
    "tools:i18n": "node tools/i18n-audit.mjs",
    "tools:proofs": "node tools/proof-check.mjs",
    "tools:proofs:fix": "node tools/proof-check.mjs --fix",
    "tools:proofs:anchor": "node tools/proof-check.mjs --anchor",
    "tools:contrast": "node tools/contrast.mjs",
    "tools:smoke": "node tools/smoke.mjs",
    "tools:tokens": "node tools/sync-tokens.mjs",
    "tools:tokens:check": "node tools/sync-tokens.mjs --check",
    "tools:bangla": "node tools/bangla-metrics.mjs",
    "tools:impeccable": "node tools/check-detector.mjs",
    "tools:hover": "node tools/hover-probe.mjs",
    "tools:serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
